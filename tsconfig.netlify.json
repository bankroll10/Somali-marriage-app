{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.netlify.tsbuildinfo",
    "target": "es2023",
    /* DOM for the Request/Response the Netlify runtime hands the handler. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    /* Deno resolves edge-function imports with their real .ts extension. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Their tests live in tests/, deliberately outside netlify/ — Netlify treats
     every file in the functions and edge-functions directories as deployable. */
  "include": ["netlify/functions", "netlify/edge-functions", "tests"]
}
