{
  "name": "bread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:pg": "vitest run tests/contention.test.ts"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/functions": "^6.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
