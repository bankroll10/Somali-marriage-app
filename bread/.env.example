# Lives in Netlify → Site configuration → Environment variables. Never
# bundled into the browser. Copy to .env for `netlify dev`.

# The password for /admin. Unset means the admin page is closed to everyone —
# it holds names and phone numbers, so a missing variable must lock it, not
# open it. It is sent once, to /api/admin-session, and exchanged for a signed
# 30-day session token; guessing is limited to 5 failures per address and 50
# overall per 15 minutes, counted in the database. Changing it signs every
# phone out. Never write the real one into this repository — it is public,
# and git remembers; the one that was once committed in a test has been
# rotated. Chosen over a hosted identity provider for a shop this size — see
# docs/BUILD_STATUS.md.
ADMIN_PASSWORD=

# Stripe. Both are server-only; the browser never sees them and never sees a
# card number — Stripe's hosted page does. Use the TEST keys (sk_test_…,
# whsec_… from `stripe listen` or a test-mode webhook endpoint) for all
# development; switch to live keys only at launch. Card checkout answers
# 503 "payments_not_configured" while these are unset.
#   Secret key:      Dashboard → Developers → API keys
#   Webhook secret:  Dashboard → Developers → Webhooks → endpoint
#                    https://<site>/api/stripe-webhook with events
#                    checkout.session.completed, checkout.session.expired,
#                    checkout.session.async_payment_succeeded,
#                    checkout.session.async_payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Going live without pasting over the test keys: the live pair sits beside
# the test pair, and STRIPE_MODE=live switches to it (absent = test). In live
# mode a missing or non-live value refuses card payments rather than falling
# back to test. Staged from /admin → Going live; never commit a value here.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_MODE=

# The database: a regular Postgres connection string. Netlify also sells a
# zero-config, auto-provisioned database, but it isn't available on this
# account's plan — deploying with a netlify/database/migrations directory
# present fails with "database feature not available for this account", which
# is why migrations live in db/migrations instead and are applied by hand.
#
# Any Postgres works — this app was set up against a free Neon project
# (neon.tech: create a project, copy the connection string it gives you).
# Other options (Supabase, Railway, a self-hosted box) work the same way.
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Then apply the schema once (and again after any new migration file):
#   npm run db:migrate
DATABASE_URL=

# Tests run on PGlite (Postgres in-process) with Stripe faked and need
# nothing. To also run the multi-connection contention suite against a real
# Postgres you may wipe:
#   TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/bread_test
# then `npm run test:pg`. CI (.github/workflows/bread.yml) runs both.
TEST_DATABASE_URL=

# Before the first real customer, wipe the test orders that occupy real
# pickup dates (deletes every order; keeps products, capacities and blocks;
# refuses while a real, live-mode sale is in the database):
#   npm run db:clear-orders -- --yes
# Her records as CSV:  npm run db:export -- --from 2026-09-01 --to 2026-12-31
# The deployed site, checked from anywhere with no secrets:
#   npm run smoke -- https://<site>          npm run launch:preflight -- https://<site>

# Her Zelle name and handle stay in shared/config.ts (ZELLE_NAME,
# ZELLE_HANDLE) for the manual "mark paid" path; customers pay by card.
