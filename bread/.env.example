# Lives in Netlify → Site configuration → Environment variables. Never
# bundled into the browser. Copy to .env for `netlify dev`.

# The password for /admin. Unset means the admin page is closed to everyone —
# it holds names and phone numbers, so a missing variable must lock it, not
# open it.
ADMIN_PASSWORD=

# Stripe. Both are server-only; the browser never sees them and never sees a
# card number — Stripe's hosted page does. Use the TEST keys (sk_test_…,
# whsec_… from `stripe listen` or a test-mode webhook endpoint) for all
# development; switch to live keys only at launch. Card checkout answers
# 503 "payments_not_configured" while these are unset.
#   Secret key:      Dashboard → Developers → API keys
#   Webhook secret:  Dashboard → Developers → Webhooks → endpoint
#                    https://<site>/api/stripe-webhook with events
#                    checkout.session.completed, checkout.session.expired,
#                    checkout.session.async_payment_succeeded,
#                    checkout.session.async_payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The database. On Netlify this is NOT set by hand: installing
# @netlify/database and deploying provisions a Postgres (Netlify DB) and sets
# NETLIFY_DB_URL for you. Set DATABASE_URL only to point at some other
# Postgres, e.g. locally:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/bread
# then `npm run db:migrate` once.
DATABASE_URL=

# Tests run on PGlite (Postgres in-process) with Stripe faked and need
# nothing. To also run the multi-connection contention suite against a real
# Postgres you may wipe:
#   TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/bread_test
# then `npm run test:pg`.
TEST_DATABASE_URL=

# Her Zelle name and handle stay in shared/config.ts (ZELLE_NAME,
# ZELLE_HANDLE) for the manual "mark paid" path; customers pay by card.
