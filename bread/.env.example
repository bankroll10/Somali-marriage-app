# All three live in Netlify → Site configuration → Environment variables.
# None of them is ever bundled into the browser. Copy to .env for `netlify dev`.

# Stripe → Developers → API keys → Secret key. Use the sk_test_… key first and
# place a test order with card 4242 4242 4242 4242; switch to sk_live_… after.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…).
# The endpoint is https://<your-site>/api/stripe-webhook and needs the events
# checkout.session.completed and checkout.session.expired.
STRIPE_WEBHOOK_SECRET=

# The password for /admin. Unset means the admin page is closed to everyone.
ADMIN_PASSWORD=
